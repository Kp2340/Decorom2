{
  "rewrites": [
    {
      "source": "/api",
      "destination": "https://api.decorom.in/api"
    },
    {
      "source": "/api/:path*",
      "destination": "https://api.decorom.in/api/:path*"
    },
    {
      "source": "/checkout",
      "destination": "https://api.decorom.in/checkout"
    },
    {
      "source": "/checkout/:path*",
      "destination": "https://api.decorom.in/checkout/:path*"
    },
    {
      "source": "/orders",
      "destination": "https://api.decorom.in/orders"
    },
    {
      "source": "/orders/:path*",
      "destination": "https://api.decorom.in/orders/:path*"
    },
    {
      "source": "/health",
      "destination": "https://api.decorom.in/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://zendadigitalsolutions.vercel.app;"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Built-By",
          "value": "Zenda Agency (https://zendadigitalsolutions.vercel.app)"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*\\.png|.*\\.jpg|.*\\.jpeg|.*\\.webp|.*\\.svg|.*\\.ico)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
