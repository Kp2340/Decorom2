{
  "permissions": {
    "deny": [
      "Edit(.env*)",
      "Write(.env*)",
      "Bash(rm -rf*)",
      "Bash(git push --force*)"
    ],
    "ask": [
      "Bash(git push*)"
    ],
    "allow": [
      "Bash(npm run lint*)",
      "Bash(npm run build*)",
      "Bash(npm run dev*)",
      "Bash(npm run preview*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ]
  }
}
